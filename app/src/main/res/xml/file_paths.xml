<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internal App Storage (Private) -->
    <files-path name="call_recordings" path="CallRecordings/" />
    <files-path name="exports" path="exports/" />

    <!-- Cache Storage (Temporary Exports & VCF Transfers) -->
    <cache-path name="cache_files" path="." />
    <cache-path name="cache_exports" path="exports/" />
    <cache-path name="cache_recordings" path="CallRecordings/" />

    <!-- App-Specific External Storage (Scoped, covers Music and external files) -->
    <external-files-path name="external_recordings" path="." />
</paths>